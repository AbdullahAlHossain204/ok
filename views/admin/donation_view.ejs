<%- include('../partials/admin_header') %>
<h1>Donation <%= t.txn_id %></h1>
<div class="card"><dl class="dl">
<dt>Donor</dt><dd><a href="/admin/donors/<%= t.donor_id %>"><%= t.donor_name %></a></dd><dt>Phone</dt><dd><%= t.phone %></dd><dt>Amount</dt><dd><strong><%= taka(t.amount) %></strong></dd>
<dt>Date</dt><dd><%= fmtDate(t.date) %></dd><dt>Category</dt><dd><%= t.category %></dd><% if (t.fund) { %><dt>Fund</dt><dd><%= t.fund %></dd><% } %>
<dt>Purpose</dt><dd><%= t.purpose || '—' %></dd><dt>Payment method</dt><dd><%= t.payment_method %></dd><dt>Status</dt><dd><%= t.status %></dd>
<dt>Public display</dt><dd><%= t.name_visibility === 'PUBLIC' ? t.donor_name + ' (public)' : 'Anonymous Donor (private)' %></dd><dt>Note</dt><dd><%= t.note || '—' %></dd></dl></div>
<% const wa = waLink(t); %>
<div class="card wa"><% if (wa) { %><a class="btn wabtn" href="<%= wa %>" target="_blank" rel="noopener" data-wa>📲 Send WhatsApp Confirmation</a>
<p class="muted">Opens WhatsApp with the message ready. You press Send yourself.</p>
<% } else if (t.status !== 'COMPLETED') { %><p class="muted">WhatsApp confirmation is available once the donation status is COMPLETED.</p>
<% } else { %><p class="alert">This donor's phone number is not valid for WhatsApp. Edit the donation to fix it.</p><% } %></div>
<p class="actions"><a class="btn small" href="/admin/donations/<%= t.id %>/edit">Edit</a> <a class="btn small danger" href="/admin/donations/<%= t.id %>/delete">Delete</a> <a href="/admin/donations">← All donations</a></p>
<%- include('../partials/footer') %>
