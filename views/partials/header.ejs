<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= page %> | <%= site.title %></title><% const d = typeof desc !== 'undefined' ? desc : site.description; %><meta name="description" content="<%= d %>">
<meta property="og:type" content="website"><meta property="og:site_name" content="<%= site.name %>"><meta property="og:title" content="<%= page %> | <%= site.title %>"><meta property="og:description" content="<%= d %>"><meta name="theme-color" content="#0b4d3a">
<link rel="stylesheet" href="/style.css"></head><body>
<header class="top"><div class="wrap bar"><a class="brand" href="/"><% if (site.logo_v) { %><img class="logo" src="/logo?v=<%= site.logo_v %>" alt=""><% } %><%= site.name %></a>
<nav aria-label="Main"><% [['/','Home'],['/donations','Donations'],['/expenses','Expenses'],['/transactions','Transactions'],['/funds','Funds'],['/about','About']].forEach(l=>{ %><a href="<%= l[0] %>" <%- path===l[0]?'aria-current="page"':'' %>><%= l[1] %></a><% }) %></nav></div></header><main class="wrap">
