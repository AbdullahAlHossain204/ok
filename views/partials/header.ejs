<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= page %> | <%= site.title %></title>
<% const d = typeof desc !== 'undefined' ? desc : site.description; %><meta name="description" content="<%= d %>">
<meta property="og:type" content="website"><meta property="og:site_name" content="<%= site.name %>"><meta property="og:title" content="<%= page %> | <%= site.title %>"><meta property="og:description" content="<%= d %>"><meta name="theme-color" content="#0b4d3a">
<% const logoSrc = site.logo_v ? '/logo?v=' + site.logo_v : '/img/logo.jpg'; %><link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png"><link rel="icon" type="image/png" sizes="64x64" href="/img/favicon-64.png"><link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<meta property="og:image" content="<%= base %><%= logoSrc %>"><meta property="og:image:width" content="640"><meta property="og:image:height" content="640"><meta name="twitter:card" content="summary">
<link rel="stylesheet" href="/style.css"></head><body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head">
<% if (site.address || site.phone) { %><div class="topstrip"><div class="wrap"><% if (site.address) { %><span>📍 <%= site.address %></span><% } %><% if (site.phone) { %><span>☎ <%= site.phone %></span><% } %></div></div><% } %>
<div class="wrap bar2"><a class="brand2" href="/"><%- include('emblem') %><span class="bt"><strong><%= site.short_name || site.name %></strong><% if (site.name_bn) { %><small lang="bn"><%= site.name_bn %></small><% } %></span></a>
<nav aria-label="Main"><% [['/','Home'],['/donations','Donations'],['/stats','Statistics'],['/about','About']].forEach(l=>{ %><a href="<%= l[0] %>" <%- path===l[0]?'aria-current="page"':'' %>><%= l[1] %></a><% }) %></nav></div></header>
<% if (typeof hero !== 'undefined' && hero) { %><section class="hero"><div class="wrap">
<img class="hero-logo" src="<%= logoSrc %>" alt="<%= site.name %> logo" width="190" height="190">
<h1><%= site.name %></h1><% if (site.name_bn) { %><p class="bn" lang="bn"><%= site.name_bn %></p><% } %>
<p class="tag">Every taka collected and every taka spent — shown openly for everyone.</p>
<p class="cta"><a class="btn small" href="/donations">View Donations</a> <a class="btn small ghost" href="/stats">Statistics</a></p></div></section><% } %>
<main id="main" class="wrap">
