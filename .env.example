PORT=3000
# Use a long random string (20+ characters). Required in production.
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Set to production when the site is live (enables secure cookies + HTTPS-only headers)
NODE_ENV=development
# Set to 1 when hosting behind a proxy/host (needed for correct login rate limiting)
# TRUST_PROXY=1
# Hours ahead of UTC for dates (Bangladesh = 6)
TZ_OFFSET_HOURS=6
# Optional: where the database file lives
# DB_FILE=madrasa.db
