PORT=3000
# Use a long random string (20+ characters). REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Set to production when the site is live (enables secure cookies + HTTPS-only headers)
NODE_ENV=development
# Set to 1 when hosting behind a proxy/host such as Render (needed for correct login rate limiting)
# TRUST_PROXY=1
# Hours ahead of UTC for dates (Bangladesh = 6)
TZ_OFFSET_HOURS=6

# ---- Database ----
# Leave both Turso lines empty to use a local file (madrasa.db) on your own computer.
# For free online hosting, create a Turso database and paste its URL and token here (or in Render's Environment settings).
# TURSO_DATABASE_URL=libsql://your-database-name-your-account.turso.io
# TURSO_AUTH_TOKEN=
# Optional: where the local database file lives
# DB_FILE=madrasa.db
