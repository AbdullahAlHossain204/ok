PORT=3000
# Long random text (20+ characters). Required in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Used to create the FIRST admin automatically when the database has no admin yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Set to production when the site is live (secure cookies + HTTPS-only headers)
NODE_ENV=development
# Set to 1 on Render or any host that puts a proxy in front (needed for correct login rate limiting)
# TRUST_PROXY=1
# Hours ahead of UTC for dates (Bangladesh = 6)
TZ_OFFSET_HOURS=6

# ---- Where the data lives ----
# LIVE SITE (Render etc.): your Turso database. The data then survives every redeploy and restart.
# TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
# On your own computer leave both lines above out: the data is kept in a local file (madrasa.db).
# DB_FILE=madrasa.db
